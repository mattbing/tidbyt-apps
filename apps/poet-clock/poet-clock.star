"""
Poet Clock - Shows a tiny three-line poem written for the current minute.

All 1,440 poems live in the POEMS dict at the bottom of this file, keyed by
minute ("10:14am"). The app picks the poem for the current minute and lays it
out in the 4x6 tom-thumb font. Poems that fit in five lines are shown as a
single static frame; longer ones gently scroll up and back down.
"""

load("render.star", "render")
load("schema.star", "schema")
load("time.star", "time")
load("encoding/json.star", "json")

DEFAULT_TZ = "America/New_York"
DEFAULT_COLOR = "#FFF1D0"

FONT = "tom-thumb"
CHAR_W = 4  # tom-thumb is monospace: 4px advance, 6px tall
LINE_H = 6
SCREEN_W = 64
SCREEN_H = 32
CHARS_PER_LINE = SCREEN_W // CHAR_W  # 16
MAX_STATIC_LINES = SCREEN_H // LINE_H  # 5

# Scroll timing for poems taller than the screen (in frames at FRAME_DELAY ms).
FRAME_DELAY = 100
HOLD_TOP = 25
HOLD_BOTTOM = 30

def sanitize(text):
    # tom-thumb has no em dash glyph; it renders as 0px and words run together.
    return text.replace("—", "-").replace("–", "-")

def wrap_line(line, width):
    """Greedy word wrap for a monospace font. Never returns an empty list."""
    out = []
    cur = ""
    for word in line.split(" "):
        if word == "":
            continue
        if len(word) > width:
            if cur != "":
                out.append(cur)
                cur = ""
            for i in range(0, len(word), width):
                out.append(word[i:i + width])
            continue
        if cur == "":
            cur = word
        elif len(cur) + 1 + len(word) <= width:
            cur = cur + " " + word
        else:
            out.append(cur)
            cur = word
    if cur != "":
        out.append(cur)
    if len(out) == 0:
        out.append(" ")
    return out

def layout_lines(poem):
    """Split a poem into screen lines, preserving the poet's line breaks."""
    lines = []
    for raw in sanitize(poem).split("\n"):
        lines.extend(wrap_line(raw, CHARS_PER_LINE))
    return lines

def text_column(lines, color):
    return render.Column(
        children = [render.Text(content = l, font = FONT, color = color) for l in lines],
    )

def render_static(lines, color):
    top = (SCREEN_H - LINE_H * len(lines)) // 2
    return render.Padding(pad = (0, top, 0, 0), child = text_column(lines, color))

def render_scrolling(lines, color):
    """Hold at the top, drift up to reveal the end, hold, drift back down.

    The last frame sits 1px above the first, so looping back to frame 0 is
    just one more step of the same motion: no jump, no flicker.
    """
    column = text_column(lines, color)
    overflow = LINE_H * len(lines) - SCREEN_H
    offsets = [0] * HOLD_TOP
    offsets.extend(range(1, overflow + 1))
    offsets.extend([overflow] * HOLD_BOTTOM)
    offsets.extend(range(overflow - 1, 0, -1))
    frames = [render.Padding(pad = (0, -y, 0, 0), child = column) for y in offsets]
    return render.Animation(children = frames)

def render_poem(poem, color):
    lines = layout_lines(poem)
    if len(lines) <= MAX_STATIC_LINES:
        return render_static(lines, color)
    return render_scrolling(lines, color)

def get_timezone(config):
    loc = config.get("location")
    if loc:
        tz = json.decode(loc).get("timezone")
        if tz:
            return tz
    return config.get("$tz") or DEFAULT_TZ

def current_key(config):
    """Return the current minute as a POEMS key like "10:14am"."""
    override = config.get("time")
    if override:
        # Preview aid: "time=10:14am" renders that minute's poem.
        t = time.parse_time(override.strip().lower(), format = "3:04pm")
    else:
        t = time.now().in_location(get_timezone(config))
    return t.format("3:04pm").lower()

def main(config):
    color = config.get("color") or DEFAULT_COLOR
    minute_key = current_key(config)
    text = POEMS.get(minute_key)
    if not text:
        text = "No poem yet\nfor " + minute_key + "."

    return render.Root(
        delay = FRAME_DELAY,
        child = render_poem(text, color),
    )

def get_schema():
    return schema.Schema(
        version = "1",
        fields = [
            schema.Location(
                id = "location",
                name = "Location",
                desc = "Used for the time zone.",
                icon = "locationDot",
            ),
            schema.Color(
                id = "color",
                name = "Text color",
                desc = "Color of the poem.",
                icon = "brush",
                default = DEFAULT_COLOR,
            ),
        ],
    )

